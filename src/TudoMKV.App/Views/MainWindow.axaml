<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TudoMKV.App.ViewModels"
        x:Class="TudoMKV.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TudoMKV"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        DragDrop.AllowDrop="True">

  <Window.Resources>
    <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13M8,12V17L12,14.5L8,12Z</StreamGeometry>
    <StreamGeometry x:Key="IconDisc">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16M12,10.5A1.5,1.5 0 0,0 10.5,12A1.5,1.5 0 0,0 12,13.5A1.5,1.5 0 0,0 13.5,12A1.5,1.5 0 0,0 12,10.5Z</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="HeaderedContentControl.group">
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="3" Padding="8,4,8,8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}" FontSize="12" Margin="0,0,0,6" Opacity="0.8" />
              <ContentPresenter Content="{TemplateBinding Content}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, DataType=vm:TreeNodeViewModel}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,3*,5,1.3*,Auto">

    <!-- Menu -->
    <Menu Grid.Row="0">
      <MenuItem Header="_Arquivo">
        <MenuItem Header="Abrir _arquivo…" InputGesture="Ctrl+O" HotKey="Ctrl+O" Click="OnOpenFileClick" />
        <MenuItem Header="Abrir _pasta de disco…" Click="OnOpenFolderClick" />
        <MenuItem Header="Abrir _disco" x:Name="DiscMenu" SubmenuOpened="OnDiscMenuOpened">
          <MenuItem Header="(procurando…)" IsEnabled="False" />
        </MenuItem>
        <Separator />
        <MenuItem Header="_Sair" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="A_juda">
        <MenuItem Header="_Sobre o TudoMKV" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- Barra de ferramentas -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="6,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" ToolTip.Tip="Abrir arquivo (VIDEO_TS.IFO, index.bdmv, MovieObject.bdmv, ISO ou vídeo)" Click="OnOpenFileClick" IsEnabled="{Binding IsIdle}">
          <PathIcon Data="{StaticResource IconFile}" />
        </Button>
        <Button Classes="tool" ToolTip.Tip="Abrir pasta de disco (VIDEO_TS ou BDMV)" Click="OnOpenFolderClick" IsEnabled="{Binding IsIdle}">
          <PathIcon Data="{StaticResource IconFolder}" />
        </Button>
        <Button Classes="tool" ToolTip.Tip="Abrir disco no drive" IsEnabled="{Binding IsIdle}">
          <PathIcon Data="{StaticResource IconDisc}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnDiscFlyoutOpening" />
          </Button.Flyout>
        </Button>
        <Button Classes="tool" ToolTip.Tip="Make MKV: gravar os títulos marcados" Command="{Binding MakeMkvCommand}">
          <PathIcon Data="{StaticResource IconSave}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Árvore e painel direito -->
    <Grid Grid.Row="2" ColumnDefinitions="*,6,*" Margin="6,6,6,0">

      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="8,3">
            <Grid ColumnDefinitions="178,*">
              <TextBlock Text="Tipo" FontSize="12" />
              <TextBlock Grid.Column="1" Text="Descrição" FontSize="12" />
            </Grid>
          </Border>
          <Panel>
            <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" FontSize="13">
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                  <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Width="{Binding TypeWidth}" Spacing="4">
                      <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding HasCheckBox}" MinWidth="0" MinHeight="0" Padding="0" />
                      <TextBlock Text="{Binding TypeText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock Text="Arraste um VIDEO_TS.IFO, um index.bdmv, uma pasta de disco ou vídeos para cá"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                       IsVisible="{Binding !Nodes.Count}" />
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom" IsVisible="{Binding IsBusy}" />
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="Transparent" />

      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,6,Auto" Margin="0,0,0,6">
          <HeaderedContentControl Classes="group" Header="Pasta de saída">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBox Text="{Binding OutputDirectory}" />
              <Button Grid.Column="1" Classes="tool" Margin="4,0,0,0" ToolTip.Tip="Escolher pasta" Click="OnChooseOutputClick">
                <PathIcon Data="{StaticResource IconFolder}" />
              </Button>
            </Grid>
          </HeaderedContentControl>
          <HeaderedContentControl Grid.Column="2" Classes="group" Header="Make MKV">
            <Button Command="{Binding MakeMkvCommand}" ToolTip.Tip="Gravar os títulos marcados" Padding="12,8" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconSave}" Width="30" Height="30" />
            </Button>
          </HeaderedContentControl>
        </Grid>
        <HeaderedContentControl Classes="group" Header="Informações">
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding InfoText}" TextWrapping="Wrap" FontSize="13" />
          </ScrollViewer>
        </HeaderedContentControl>
      </DockPanel>
    </Grid>

    <GridSplitter Grid.Row="3" Background="Transparent" ResizeDirection="Rows" />

    <!-- Log -->
    <Border Grid.Row="4" Margin="6,0,6,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
      <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontSize="12" Padding="2">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Barra de status -->
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" Margin="6,4,6,6">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
      <ProgressBar Grid.Column="1" Width="260" Margin="8,0" Value="{Binding Progress}" ShowProgressText="True" IsVisible="{Binding IsRipping}" />
      <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding IsRipping}" />
    </Grid>
  </Grid>
</Window>
