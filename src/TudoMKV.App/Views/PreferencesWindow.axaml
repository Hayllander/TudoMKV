<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TudoMKV.App.Views.PreferencesWindow"
        Title="Preferências do TudoMKV"
        Width="560" Height="400"
        MinWidth="520" MinHeight="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto" Margin="14">
    <TabControl>
      <TabItem Header="Integration">
        <Border Padding="14">
          <Grid RowDefinitions="Auto,18,Auto,12,Auto,10,Auto,12,Auto,*">
            <TextBlock Text="O TudoMKV pode fazer integração com algumas API disponíveis para melhorar as informações do MKV. O TMDb é a fonte principal e o OMDb responde pelos códigos do IMDb."
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2" ColumnDefinitions="150,*" VerticalAlignment="Center">
              <TextBlock Text="API escolhida:" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ComboBox x:Name="ProviderCombo" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Nenhuma" />
                <ComboBoxItem Content="TMDb, com o OMDb de reserva" />
              </ComboBox>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="150,*" VerticalAlignment="Center">
              <TextBlock Text="Chave do TMDb:" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBox x:Name="TmdbKeyBox" Grid.Column="1" PlaceholderText="Chave da API do TMDb (v3)" />
            </Grid>

            <Grid Grid.Row="6" ColumnDefinitions="150,*" VerticalAlignment="Center">
              <TextBlock Text="Chave do OMDb:" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBox x:Name="ApiDataBox" Grid.Column="1" PlaceholderText="Chave da API OMDb, usada nos códigos do IMDb" />
            </Grid>

            <TextBlock Grid.Row="8"
                       Text="Observação: informe o número do filme no TMDb (223883) ou o link dele para a ficha sair do TMDb; um código do IMDb (tt1234567) continua sendo consultado no OMDb."
                       TextWrapping="Wrap"
                       Opacity="0.7" />
          </Grid>
        </Border>
      </TabItem>

      <TabItem Header="Muxing">
        <Border Padding="14">
          <Grid RowDefinitions="Auto,12,Auto,10,Auto,12,Auto,10,Auto,*">
            <TextBlock Text="Ajustes aplicados na hora de gravar o MKV." TextWrapping="Wrap" />

            <CheckBox x:Name="Mpeg2CompatBox" Grid.Row="2"
                      Content="Marcar MKV de vídeo MPEG-2 como libmakemkv" />

            <TextBlock Grid.Row="4"
                       Text="Sem essa marca, o VLC 3 pode mostrar imagem verde ao avançar um MKV de vídeo MPEG-2 com decodificação por hardware. O arquivo em si não muda: é só o nome do aplicativo gravador que fica registrado no MKV, como acontece nos arquivos do MakeMKV."
                       TextWrapping="Wrap"
                       Opacity="0.7" />

            <Grid Grid.Row="6" ColumnDefinitions="150,*" VerticalAlignment="Center">
              <TextBlock Text="Grupo da release:" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBox x:Name="ReleaseGroupBox" Grid.Column="1" PlaceholderText="HAY" />
            </Grid>

            <TextBlock Grid.Row="8"
                       Text="Assinatura no fim do nome do MKV, como nas releases de cena (o &quot;-HAY&quot; de Painted.Skin.2008.1080p.BluRay.REMUX.AVC.DTS-HD.MA7.1-HAY). Vale quando o filme é identificado no TMDb ou no IMDb e há um único título marcado; deixe em branco para gravar sem assinatura."
                       TextWrapping="Wrap"
                       Opacity="0.7" />
          </Grid>
        </Border>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Content="OK" MinWidth="90" Click="OnOkClick" />
      <Button Content="Cancelar" MinWidth="90" Click="OnCancelClick" />
      <Button Content="Apply" MinWidth="90" Click="OnApplyClick" />
    </StackPanel>
  </Grid>
</Window>
